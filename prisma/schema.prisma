generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id        String   @id @default(cuid())
  name      String?
  nickname  String?
  phone     String?
  email     String?  @unique
  image     String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments       enrollment[]
  lessonProgress    lessonprogress[]
  streak            streak?
  listeningProgress ListeningProgress[]
  gameScores        GameScore[]
  wordBoxes         WordBox[]
}

model course {
  id          String       @id
  title       String
  titleEn     String?
  description String?
  level       course_level @default(BEGINNER)
  imageUrl    String?
  color       String?
  isPublished Boolean      @default(false)
  order       Int          @default(0)

  lessons     lesson[]
  enrollments enrollment[]
}

model lesson {
  id       String      @id @default(cuid())
  courseId String
  title    String
  /// محتوای درس (JSON یا HTML)
  content  String?     @db.LongText
  videoUrl String?
  order    Int         @default(0)
  duration Int?
  xp       Int         @default(10)
  /// 👇 مهم: ساختار تدریس + تمرین
  type     lesson_type @default(TEACH)

  course    course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  lessonprogress[]
  exercises exercise[]
}

model lessonprogress {
  id          String    @id
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  score       Int?
  currentStep Int  @default(0)
  xpEarned    Int  @default(0)

  @@unique([userId, lessonId])
}

model enrollment {
  id       String @id @default(cuid())
  userId   String
  courseId String
  user     user   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now())
  progress   Int      @default(0)

  @@unique([userId, courseId])
}

model streak {
  id           String   @id @default(cuid())
  userId       String   @unique
  current      Int      @default(0)
  longest      Int      @default(0)
  lastActiveAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model exercise {
  id     String        @id
  type   exercise_type
  xp     Int           @default(10)
  lesson lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  answer   String
  lessonId String
  options  Json?
  order    Int    @default(0)
  question String @db.LongText
}

enum lesson_type {
  TEACH
  PRACTICE
  QUIZ
}

enum course_level {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum exercise_type {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  MATCHING
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  titleFa     String
  author      String
  description String
  level       String   @default("BEGINNER")
  coverUrl    String
  pdfPath     String
  pages       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ListeningEpisode {
  id          String  @id @default(cuid())
  title       String
  titleEn     String
  titleFa     String
  description String
  audioUrl    String
  level       String  @default("BEGINNER")
  duration    Int     @default(0)
  xp          Int     @default(30)
  order       Int     @default(0)
  isPublished Boolean @default(true)
  transcript  String   @db.LongText
  gaps        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress ListeningProgress[]
}

model ListeningProgress {
  id        String @id @default(cuid())
  userId    String
  episodeId String

  stars       Int       @default(0)
  score       Int       @default(0)
  xpEarned    Int       @default(0)
  completedAt DateTime?

  user    user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode ListeningEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

// ========================================
// بخش بازی‌ها (Hangman)
// ========================================

/// کلمات بازی هنگ‌من — منبع: data/hangman/words.ts (seed)
model GameWord {
  id       Int     @id @default(autoincrement())
  word     String
  hint     String
  category String  @default("general")
  level    String  @default("BEGINNER")
  isActive Boolean @default(true)
}

/// امتیاز و آمار بازی هر کاربر — فقط در صفحه بازی‌ها نمایش داده می‌شود
model GameScore {
  id             String   @id @default(cuid())
  userId         String
  game           String   @default("hangman")
  bestScore      Int      @default(0)
  totalWins      Int      @default(0)
  totalLosses    Int      @default(0)
  sessionsPlayed Int      @default(0)
  lastPlayedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
}

// ========================================
// بازی حافظه کلمات (Memory Match)
// ========================================

/// جفت کلمات بازی حافظه — منبع: data/memory/words.ts (seed)
/// هر ردیف یک کلمه انگلیسی + معنی فارسی آن
model MemoryWord {
  id          Int     @id @default(autoincrement())
  word        String
  translation String
  category    String  @default("general")
  level       String  @default("EASY")
  isActive    Boolean @default(true)
}

// ========================================
// بازی کوییز سرعتی (Speed Quiz)
// ========================================

/// سوال‌های بازی کوییز سرعتی — منبع: data/speedquiz/questions.ts (seed)
/// type=WORD → prompt=کلمه انگلیسی، گزینه‌ها=معنی فارسی
/// type=SENTENCE → prompt=جمله با جای خالی ___، گزینه‌ها=کلمه انگلیسی
/// distractors = JSON آرایه ۳ گزینه اشتباه
model SpeedQuizQuestion {
  id          Int     @id @default(autoincrement())
  type        String  @default("WORD")
  prompt      String
  answer      String
  distractors String  @default("[]")
  translation String  @default("")
  category    String  @default("general")
  level       String  @default("EASY")
  cefr        String  @default("A1")
  isActive    Boolean @default(true)

  @@index([level, isActive])
}

// ========================================
// لغت‌نامه (نسخه ۱.۰.۱.۶)
// جعبه‌های لغات کاربر — هر جعبه حداکثر ۱۰ کلمه
// منبع: هاور روی کلمه‌ها در کل سایت + افزودن دستی از صفحه لغت‌نامه
// ========================================

/// جعبه لغات کاربر
model WordBox {
  id        Int          @id @default(autoincrement())
  userId    String
  name      String       @db.VarChar(60)
  createdAt DateTime     @default(now())

  user  user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  words WordBoxItem[]

  @@index([userId])
}

/// کلمه داخل جعبه — word انگلیسی + معنی فارسی (در صورت وجود)
model WordBoxItem {
  id          Int      @id @default(autoincrement())
  boxId       Int
  word        String   @db.VarChar(80)
  translation String?  @db.VarChar(160)
  addedAt     DateTime @default(now())

  box WordBox @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@unique([boxId, word])
  @@index([boxId])
}
